FROM quay.io/almalinuxorg/almalinux-bootc:10@sha256:585a7eaab4e56a11e58042a835c4d328a72d6248019f01ee7fc3746d66a6d113 AS base-amd64
FROM quay.io/almalinuxorg/almalinux-bootc-rpi:10@sha256:e30d86086673073c8077e43ff4c81dfeac4963b994ad0646ab2c031e8e4bddcd AS rpi-raw

# pre-built BCM2712 kernel RPMs — see github.com/joshgordon/almalinux-rpi5-kernel
FROM ghcr.io/joshgordon/almalinux-rpi5-kernel:latest@sha256:ce99af6d457c7e50939a5732eaa7e25cd16de852a4856c0dfaccb060cfb53afe AS kbuild

# base-arm64: rpi base + the rebuilt kernel swapped in, NO build tooling
FROM rpi-raw AS base-arm64
COPY --from=kbuild /rpms/ /tmp/kernel/
RUN dnf -y remove --noautoremove 'raspberrypi2-kernel4*' && \
    rm -rf /usr/lib/modules/* && \
    # /root -> /var/roothome; target must exist for dracut to build the initramfs
    mkdir -p /var/roothome && chmod 700 /var/roothome && \
    dnf -y install /tmp/kernel/*.rpm && \
    rm -rf /tmp/kernel /var/roothome && dnf -y clean all && \
    rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf && \
    test "$(ls -1 /usr/lib/modules | wc -l)" -eq 1 && \
    KVER=$(ls /usr/lib/modules) && \
    # %posttrans writes kernel/initramfs to /boot/ (for real systems with a FAT32 /boot).
    # bootc ignores /boot/ in the image layer and only reads /usr/lib/modules/<kver>/.
    # Copy with the names bootc expects.
    cp /boot/kernel-"$KVER".img    /usr/lib/modules/"$KVER"/vmlinuz && \
    cp /boot/initramfs-"$KVER".img /usr/lib/modules/"$KVER"/initramfs && \
    rm -rf /boot/* && \
    test -f /usr/lib/modules/"$KVER"/vmlinuz && \
    test -f /usr/lib/modules/"$KVER"/initramfs

# re-enable cgroup_memory.
RUN dnf install -y dtc && \
    for dtb in /usr/share/raspberrypi2-kernel4*/*/boot/bcm27*.dtb; do \
        [ -f "$dtb" ] || continue; \
        args=$(fdtget "$dtb" /chosen bootargs 2>/dev/null) || continue; \
        echo "Before ($dtb): $args"; \
        newargs=$(echo "$args" | sed 's/cgroup_disable=memory //g;s/ cgroup_disable=memory//g;s/cgroup_disable=memory//g'); \
        fdtput "$dtb" /chosen bootargs "$newargs" && \
        echo "After: $newargs"; \
    done && \
    dnf remove -y dtc && \
    dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf

FROM base-${TARGETARCH}
ARG TARGETARCH

# renovate: datasource=github-tags depName=kubernetes/kubernetes extractVersion=^v(?<version>\d+\.\d+) versioning=regex:^(?<major>\d+)\.(?<minor>\d+)$
ARG k8s_version=1.36

# renovate: datasource=github-releases depName=cilium/cilium-cli
ARG CILIUM_CLI_VERSION=v0.19.7

COPY modules-load-k8s.conf /usr/lib/modules-load.d/k8s.conf
COPY sysctl-k8s.conf /usr/lib/sysctl.d/k8s.conf
RUN mkdir -p /etc/systemd/system/bootc-fetch-apply-updates.service.d
COPY disable-bootc-reboot.service /etc/systemd/system/bootc-fetch-apply-updates.service.d/disable-bootc-reboot.service
COPY iscsi-initiatorname-regen.service /usr/lib/systemd/system/iscsi-initiatorname-regen.service

RUN dnf install -y epel-release && crb enable && \
    dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf

COPY kubernetes.repo /etc/yum.repos.d/kubernetes.repo

RUN sed -i "s|__K8S_VERSION__|${k8s_version}|g" /etc/yum.repos.d/kubernetes.repo && \
  dnf install -y kubelet kubeadm kubectl containerd cri-tools runc conntrack vim && \
  systemctl enable kubelet && \
  dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf

RUN mkdir -p /etc/containerd && \
  containerd config default > /etc/containerd/config.toml && \
  sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml && \
  sed -i "s|bin_dirs = \['/opt/cni/bin'\]|bin_dirs = ['/var/lib/cni/bin', '/opt/cni/bin']|" /etc/containerd/config.toml && \
  systemctl enable containerd

# Longhorn host dependencies: iSCSI initiator (volume attach), NFS client
# (RWX / backup target), cryptsetup (encrypted volumes).
# iscsi-initiator-utils bakes a fixed InitiatorName into /etc at install
# time; drop it so every host gets a unique one on first boot instead of
# every clone of this image sharing the same iSCSI identity.
RUN dnf install -y iscsi-initiator-utils nfs-utils cryptsetup && \
  rm -f /etc/iscsi/initiatorname.iscsi && \
  systemctl enable iscsid.service iscsi-initiatorname-regen.service && \
  dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf

# Install cilium
RUN curl -L --fail --remote-name-all https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-${TARGETARCH}.tar.gz{,.sha256sum} && \
  sha256sum --check cilium-linux-${TARGETARCH}.tar.gz.sha256sum && \
  sudo tar xzvfC cilium-linux-${TARGETARCH}.tar.gz /usr/local/bin && \
  rm cilium-linux-${TARGETARCH}.tar.gz{,.sha256sum}

RUN bootc container lint
