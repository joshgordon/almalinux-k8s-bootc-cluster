# Live environment for the installer ISO: AlmaLinux's bootc base image plus a
# console installer (k8s-node-installer) on tty1, with no Anaconda or desktop.
# disk-images.yml turns it into an ISO with image-builder's bootc-generic-iso,
# following AlmaLinux atomic-ci's build-iso. The node image is downloaded at
# install time, not embedded.
#
# Build with --cap-add sys_admin --security-opt label=disable

FROM quay.io/almalinuxorg/almalinux-bootc:10@sha256:932f2c68b53fa050423591123c4626501dac03f8ace5a8fcafa65e2b54cd7e55

# The image the installer installs, and that installed nodes update from
ARG IMAGE_REF=ghcr.io/joshgordon/almalinux-k8s-bootc-cluster:latest

RUN --mount=type=bind,source=.,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh
